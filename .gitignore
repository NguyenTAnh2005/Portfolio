# --- CHUNG (Toàn bộ dự án) ---
.DS_Store
.vscode/
.idea/
*.log

# --- BACKEND (Python/FastAPI) ---
BACKEND/__pycache__/
BACKEND/*.pyc
BACKEND/venv/
BACKEND/.env
BACKEND/.pytest_cache/

# --- FRONTEND (ReactJS) ---
# Thư mục nặng nhất quả đất - TUYỆT ĐỐI KHÔNG UP
FRONTEND/node_modules/

# Thư mục build ra sản phẩm (không cần up code nguồn)
FRONTEND/build/
FRONTEND/dist/

# File biến môi trường local của React
FRONTEND/.env
FRONTEND/.env.local
FRONTEND/.env.development.local
FRONTEND/.env.test.local
FRONTEND/.env.production.local
FRONTEND/npm-debug.log*
FRONTEND/yarn-debug.log*
FRONTEND/yarn-error.log*
